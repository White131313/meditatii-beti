{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/course/gymnasium_curriculum", "destination": "/materie-gimnaziu", "statusCode": 301 },
    { "source": "/course/national_exam_prep", "destination": "/evaluare-nationala", "statusCode": 301 },
    { "source": "/course/adults_communication", "destination": "/comunicare-adulti", "statusCode": 301 },
    { "source": "/course/practice_exercises", "destination": "/exercitii", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/login", "destination": "/spa.html" },
    { "source": "/register", "destination": "/spa.html" },
    { "source": "/hu/login", "destination": "/spa.html" },
    { "source": "/hu/register", "destination": "/spa.html" },
    { "source": "/quiz/:lessonId", "destination": "/spa.html" },
    { "source": "/hu/quiz/:lessonId", "destination": "/spa.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
